{
  "name": "dsh-seal-scripts",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "description": "Seal proven command chains into reusable executable tool scripts for DSH agents. DSH 代码脚本固存，留住模型成功自实现的工作流。",
  "license": "MIT",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "ai",
    "ai-agents",
    "llm",
    "agent",
    "cli",
    "plugin",
    "nodejs",
    "npm",
    "automation",
    "workflow",
    "tools",
    "memory",
    "context",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gosutry/dsh-seal-scripts.git"
  },
  "homepage": "https://github.com/gosutry/dsh-seal-scripts#readme",
  "bugs": {
    "url": "https://github.com/gosutry/dsh-seal-scripts/issues"
  }
}
